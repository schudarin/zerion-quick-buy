{
  "manifest_version": 3,
  "name": "Quick Buy with Zerion",
  "description": "Adds a Zerion Quick Buy banner on supported token pages for streamlined swaps.",
  "version": "5.6",
  "permissions": [
    "activeTab",
    "tabs",
    "contextMenus",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://dexscreener.com/solana/*",
    "https://dexscreener.com/base/*",
    "https://dexscreener.com/ethereum/*",
    "https://app.interface.social/token/*"
  ],
  "icons": {
    "16": "/icons/icon-16.png",
    "32": "/icons/icon-32.png",
    "48": "/icons/icon-48.png",
    "128": "/icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["Banner/zqb-banner.css", "TokenInfo/token-info.css"],
      "matches": [
        "https://dexscreener.com/*",
        "https://app.interface.social/*",
        "https://x.com/*"
      ]
    },
    {
      "resources": ["TokenInfo/token-info.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://dexscreener.com/*",
        "https://app.interface.social/*"
      ],
      "js": [
        "Banner/zqb-utils.js",
        "QuickActions/quick-actions.js",
        "Banner/zqb-banner.js",
        "TokenInfo/fake-data.js",
        "TokenInfo/token-info.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": [
        "Banner/zqb-utils.js",
        "QuickActions/quick-actions.js",
        "Banner/zqb-banner.js",
        "TokenInfo/fake-data.js",
        "TokenInfo/token-info.js",
        "QuickActions/copy-listener.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": { "default_popup": "Popup/popup.html" },
  "background": { "service_worker": "background.js" }
}
