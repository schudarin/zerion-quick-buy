{
  "manifest_version": 3,
  "name": "Quick Buy with Zerion",
  "description": "Adds a Zerion Quick Buy banner on supported token pages for streamlined swaps.",
  "version": "1.6",
  "permissions": [
    "activeTab",
    "tabs",
    "contextMenus",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://dexscreener.com/solana/*",
    "https://dexscreener.com/base/*",
    "https://dexscreener.com/ethereum/*",
    "https://api.dexscreener.com/*",
    "https://app.interface.social/token/*"
  ],
  "icons": {
    "16": "/icons/icon-16.png",
    "32": "/icons/icon-32.png",
    "48": "/icons/icon-48.png",
    "128": "/icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["zerion-banner.css", "icons/banner-icons/drag-icon.svg"],
      "matches": ["https://dexscreener.com/*", "https://app.interface.social/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://dexscreener.com/*",
        "https://app.interface.social/*"
      ],
      "js": ["zqb-utils.js", "quick-actions.js", "zqb-banner.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": [
        "zqb-utils.js",
        "quick-actions.js",
        "zqb-banner.js",
        "copy-listener.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": { "default_popup": "popup.html" },
  "background": { "service_worker": "background.js" }
}
